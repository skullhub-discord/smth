local function autoTargetTick()
	if not autoTarget.on then return end
	local cam = getCamera()
	if not cam then return end
	local mouseLoc = UserInputService:GetMouseLocation()
	local best, bestDist = nil, math.huge

	for _, pl in ipairs(Players:GetPlayers()) do
		if isPlayerValid(pl) then
			local head = pl.Character:FindFirstChild("Head") or pl.Character:FindFirstChild("HumanoidRootPart")
			if head then
				local sp, onScreen = cam:WorldToViewportPoint(head.Position)
				if onScreen and sp.Z > 0 then
					local dx = sp.X - mouseLoc.X
					local dy = sp.Y - mouseLoc.Y
					local dist = math.sqrt(dx*dx + dy*dy)
					if dist <= autoTarget.radius and dist < bestDist then
						bestDist = dist
						best = pl
					end
				end
			end
		end
	end

	if best ~= autoTarget.current then
		autoTarget.current = best
		if best then
			local hum = best.Character and best.Character:FindFirstChildOfClass("Humanoid")
			local level = best:FindFirstChild("leaderstats") and best.leaderstats:FindFirstChild("Level")
			UILibrary:SetTarget({
				Name = best.Name,
				UserId = best.UserId,
				Health = hum and hum.Health or 100,
				MaxHealth = hum and hum.MaxHealth or 100,
				Stats = level and ("level " .. tostring(level.Value)) or "",
			})
			UILibrary:ShowHUD()
		else
			UILibrary:HideHUD()
		end
		autoTarget.lastHp = -1
	end

	if best then
		local hum = best.Character and best.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health ~= autoTarget.lastHp then
			autoTarget.lastHp = hum.Health
			UILibrary:SetTarget({ Health = hum.Health, MaxHealth = hum.MaxHealth })
		end
	end
end

function UILibrary:SetTarget(data)
	data = data or {}
	local r = hudRefs
	if not r.outer then return end

	if data.Name ~= nil then r.name.Text = tostring(data.Name) end
	if data.Stats ~= nil then r.stats.Text = tostring(data.Stats) end

	if data.UserId then
		local id = tonumber(data.UserId)
		if id then
			if not thumbCache[id] then thumbCache[id] = rbxThumb(id) end
			r.avatar.Image = thumbCache[id]
		end
	end

	local hp = tonumber(data.Health) or 150
	local maxHp = tonumber(data.MaxHealth) or 150
	r.health.Text = string.format("%d / %d", hp, maxHp)
	local w = (HUD_W - 150) * math.clamp(hp / math.max(1, maxHp), 0, 1)
	tween(r.fill, 0.18, { Size = UDim2.fromOffset(math.max(6, w), 4) }, Enum.EasingStyle.Quart)

	if data.DamageUp then r.up.Text = tostring(data.DamageUp) .. " ▲" end
	if data.DamageDown then r.dn.Text = tostring(data.DamageDown) .. " ▼" end
end

