local function openPicker(anchorSwatch, current, onPick)
	closePicker()
	local h, s, v = Color3.toHSV(current)

	local ap = anchorSwatch.AbsolutePosition
	local sp = Stage.AbsolutePosition
	local px = math.clamp(ap.X - sp.X + 18, 4, CANVAS_W - 172)
	local py = math.clamp(ap.Y - sp.Y + 12, 4, CANVAS_H - 140)

	local root = I("Frame", {
		Name = "ColorPicker",
		Parent = Stage,
		BackgroundColor3 = C("SubBarBg"),
		Position = UDim2.fromOffset(px, py),
		Size = UDim2.fromOffset(168, 0),
		BorderSizePixel = 0,
		ZIndex = 200,
	})
	I("UICorner", { Parent = root, CornerRadius = UDim.new(0, 10) })
	strokeOn(root, "Border", 1, 0.55).ZIndex = 201
	bindTheme(root, "BackgroundColor3", "SubBarBg")

	pickerState.open = true
	pickerState.frame = root

	local SV_W, SV_H = 118, 84

	local sv = I("TextButton", {
		Parent = root, Text = "", AutoButtonColor = false,
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(SV_W, SV_H),
		BorderSizePixel = 0, ZIndex = 201,
	})
	I("UICorner", { Parent = sv, CornerRadius = UDim.new(0, 8) })

	local gw = I("Frame", { Parent = sv, Size = UDim2.new(1,0,1,0), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 202 })
	I("UIGradient", { Parent = gw, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1) }) })
	I("UICorner", { Parent = gw, CornerRadius = UDim.new(0, 8) })

	local gb = I("Frame", { Parent = sv, Size = UDim2.new(1,0,1,0), BackgroundColor3 = Color3.new(0,0,0), BorderSizePixel = 0, ZIndex = 203 })
	I("UIGradient", { Parent = gb, Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(1,0) }) })
	I("UICorner", { Parent = gb, CornerRadius = UDim.new(0, 8) })

	local knob = I("Frame", {
		Parent = sv, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(s * SV_W - 6, (1 - v) * SV_H - 6),
		Size = UDim2.fromOffset(12, 12),
		ZIndex = 204,
	})
	local ring = circFrame(knob, 6, 6, 10, Color3.new(1,1,1), 1, 205)
	strokeOn(ring, Color3.new(1,1,1), 2, 0).ZIndex = 206

	local hue = I("TextButton", {
		Parent = root, Text = "", AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1,1,1),
		Position = UDim2.fromOffset(138, 10),
		Size = UDim2.fromOffset(12, SV_H),
		BorderSizePixel = 0, ZIndex = 201,
	})
	I("UICorner", { Parent = hue, CornerRadius = UDim.new(0, 8) })
	I("UIGradient", {
		Parent = hue, Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
			ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.83, 1, 1)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.66, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
			ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.33, 1, 1)),
			ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.16, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
		}),
	})

	local hueKnob = rectTL(hue, -2, (1 - h) * SV_H - 2, 16, 4, Color3.new(1,1,1), 2, 0)
	hueKnob.ZIndex = 202

	local preview = circFrame(root, 20, 112, 18, current, 0, 201)
	strokeOn(preview, "Border", 1, 0.55).ZIndex = 202
	local hexLabel = txt(root, 36, 104, 96, 16, hexOf(current), 11, "TextDim")
	hexLabel.ZIndex = 201

	local function apply()
		local c = Color3.fromHSV(h, s, v)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		preview.BackgroundColor3 = c
		hexLabel.Text = hexOf(c)
		anchorSwatch.BackgroundColor3 = c
		if onPick then onPick(c) end
	end

	local dragSV, dragHue = false, false
	sv.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dragSV = true end
	end)
	hue.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dragHue = true end
	end)

	local endedConn, changedConn, beganConn

	endedConn = UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragSV, dragHue = false, false
		end
	end)

	changedConn = UserInputService.InputChanged:Connect(function(inp)
		if not pickerState.open or pickerState.frame ~= root then return end
		if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end

		if dragSV then
			s = math.clamp((inp.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((inp.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
			knob.Position = UDim2.fromOffset(s * SV_W - 6, (1 - v) * SV_H - 6)
			apply()
		elseif dragHue then
			h = 1 - math.clamp((inp.Position.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 1)
			hueKnob.Position = UDim2.fromOffset(-2, (1 - h) * SV_H - 2)
			apply()
		end
	end)

	beganConn = UserInputService.InputBegan:Connect(function(inp)
		if not pickerState.open or pickerState.frame ~= root then return end
		if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
		local rp, rs = root.AbsolutePosition, root.AbsoluteSize
		local p = inp.Position
		local inside = p.X >= rp.X - 4 and p.X <= rp.X + rs.X + 4 and p.Y >= rp.Y - 4 and p.Y <= rp.Y + rs.Y + 4
		local ap2 = anchorSwatch.AbsolutePosition
		local insideSw = p.X >= ap2.X - 12 and p.X <= ap2.X + 12 and p.Y >= ap2.Y - 12 and p.Y <= ap2.Y + 12
		if not inside and not insideSw then
			if endedConn then endedConn:Disconnect() end
			if changedConn then changedConn:Disconnect() end
			if beganConn then beganConn:Disconnect() end
			closePicker()
		end
	end)

	task.defer(function()
		tween(root, 0.18, { Size = UDim2.fromOffset(168, 132) }, Enum.EasingStyle.Back)
	end)

	return root
end

local function panelPos()
	return mainPanel.Position.X.Offset, mainPanel.Position.Y.Offset
end

local function panelCenterX()
	local x, _ = panelPos()
	return x + PANEL_W/2
end

local function subbarY()
	local _, y = panelPos()
	return y + PANEL_H - SUBBAR_HALF_IN
end

local function sidebarDX()
	return SIDEBAR_X - PANEL_X
end

local function buildSidebar()
	sidebar = rectTL(Stage, SIDEBAR_X, PANEL_Y, SIDEBAR_W, 120, "SidebarBg", 12)
	sidebar.ZIndex = 10
	sidebar.Active = true
	strokeOn(sidebar, "Border", 1, 0.55).ZIndex = 11

	sideIndicator = I("Frame", {
		Parent = sidebar,
		BackgroundColor3 = C("Active"),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 21),
		Size = UDim2.fromOffset(2, 18),
		BackgroundTransparency = 1,
		ZIndex = 13,
	})
	I("UICorner", { Parent = sideIndicator, CornerRadius = UDim.new(1,0) })
	bindTheme(sideIndicator, "BackgroundColor3", "Active")
end

local function fitSidebar()
	if not (sidebar and mainPanel) then return end
	local n = math.max(1, #tabs)
	local h = math.min(PANEL_H, n * TAB_STEP + 18)

	local px, py = panelPos()
	sidebar.Size = UDim2.fromOffset(SIDEBAR_W, h)
	sidebar.Position = UDim2.fromOffset(px + sidebarDX(), py + (PANEL_H - h) / 2)
end

function UILibrary:_RefreshTabVisuals()
	if not sidebar then return end
	for _, t in ipairs(tabs) do
		local active = (t == currentTab)
		tween(t.hl, 0.0, { BackgroundColor3 = C("ActiveBg") })
		tween(t.hl, 0.0, { BackgroundTransparency = active and 0.18 or 1 })
		tweenIconColor(t.iconHolder, active and C("Active") or C("TextMuted"), 0.0)
	end
	if currentTab and currentTab.cy then
		sideIndicator.BackgroundTransparency = 0
		sideIndicator.BackgroundColor3 = C("Active")
		sideIndicator.Position = UDim2.fromOffset(0, currentTab.cy - 9)
	end
end

function UILibrary:AddTab(cfg)
	cfg = cfg or {}
	assert(sidebar, "UILibrary:Build() must be called before AddTab().")

	local index = #tabs + 1
	local cy = 10 + (index - 1) * TAB_STEP + TAB_STEP / 2

	local tab = {
		index = index,
		name = cfg.Name or ("Tab" .. index),
		icon = cfg.Icon or "grid",
		subs = {},
		currentSub = nil,
	}

	local hl = rectTL(sidebar, 6, cy - 18, SIDEBAR_W - 12, 36, "ActiveBg", 10, 1)
	hl.ZIndex = 11

	local iconHolder = I("Frame", {
		Parent = sidebar,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(6, cy - 18),
		Size = UDim2.fromOffset(SIDEBAR_W - 12, 36),
		ZIndex = 12,
	})
	if Icon[tab.icon] then
		Icon[tab.icon](iconHolder, (SIDEBAR_W - 12) / 2, 18, 18, C("TextMuted")).ZIndex = 12
	end

	local btn = I("TextButton", {
		Parent = sidebar,
		BackgroundTransparency = 1,
		Text = "",
		Position = UDim2.fromOffset(6, cy - 18),
		Size = UDim2.fromOffset(SIDEBAR_W - 12, 36),
		ZIndex = 14,
	})
	btn.MouseEnter:Connect(function()
		if currentTab ~= tab then tween(hl, 0.16, { BackgroundTransparency = 0.65 }) end
	end)
	btn.MouseLeave:Connect(function()
		if currentTab ~= tab then tween(hl, 0.20, { BackgroundTransparency = 1 }) end
	end)
	btn.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	tab.hl, tab.iconHolder, tab.btn, tab.cy = hl, iconHolder, btn, cy
	tabs[index] = tab

	fitSidebar()
	if not currentTab then self:SelectTab(tab) end
	return tab
end

function UILibrary:SelectTab(tab)
	if currentTab == tab then return end
	currentTab = tab

	for _, t in ipairs(tabs) do
		local active = (t == tab)
		tween(t.hl, 0.2, { BackgroundTransparency = active and 0.18 or 1 })
		tweenIconColor(t.iconHolder, active and C("Active") or C("TextMuted"), 0.2)
	end

	sideIndicator.BackgroundTransparency = 0
	sideIndicator.BackgroundColor3 = C("Active")
	tween(sideIndicator, 0.26, { Position = UDim2.fromOffset(0, tab.cy - 9) }, Enum.EasingStyle.Quart)

	self:RebuildSubBars(tab)
	closePicker()
	closeAllDropdowns()
end

local COLLAPSED_W, PILL_H = 34, 28

local function buildSubBar()
	subBar = rectTL(Stage, panelCenterX() - 230, subbarY(), 460, SUBBAR_H, "SubBarBg", 10)
	subBar.ZIndex = 30
	subBar.Active = true
	strokeOn(subBar, "Border", 1, 0.55).ZIndex = 31
end

local function layoutSubBar(tab)
	if not subBar then return end

	local cursor = 8
	for _, sub in ipairs(tab.subs) do
		local w = (tab.currentSub == sub) and sub.expandedW or COLLAPSED_W
		tween(sub.pill, 0.25, {
			Position = UDim2.fromOffset(cursor, (SUBBAR_H - PILL_H) / 2),
			Size = UDim2.fromOffset(w, PILL_H),
		}, Enum.EasingStyle.Quart)
		cursor = cursor + w + 6
	end

	local total = math.max(260, cursor + 2)
	local cx = panelCenterX()
	tween(subBar, 0.25, {
		Size = UDim2.fromOffset(total, SUBBAR_H),
		Position = UDim2.fromOffset(cx - total / 2, subbarY()),
	}, Enum.EasingStyle.Quart)
end

function UILibrary:_RefreshSubTabVisuals(tab)
	if not tab then return end
	for _, sub in ipairs(tab.subs) do
		local active = (tab.currentSub == sub)
		if sub.pill and sub.label and sub.iconHolder then
			sub.pill.BackgroundColor3 = active and C("ActiveBg") or C("InputBg")
			sub.pill.BackgroundTransparency = active and 0 or 0.45
			sub.label.TextColor3 = C("Text")
			sub.label.TextTransparency = active and 0 or 1
			tweenIconColor(sub.iconHolder, active and C("Active") or C("TextMuted"), 0.0)
		end
	end
end

function UILibrary:AddSubTab(tab, cfg)
	cfg = cfg or {}
	assert(subBar, "UILibrary:Build() must be called before AddSubTab().")

	local sub = {
		name = cfg.Name or ("Sub" .. (#tab.subs + 1)),
		icon = cfg.Icon or "cube",
		tab = tab,
		rows = {},
		build = cfg.Build,
	}
	tab.subs[#tab.subs + 1] = sub

	if currentTab == tab then
		self:RebuildSubBars(tab)
		if not tab.currentSub then self:SelectSubTab(tab, sub) end
	end
	return sub
end

function UILibrary:RebuildSubBars(tab)
	for _, ch in ipairs(subBar:GetChildren()) do
		if ch:IsA("Frame") or ch:IsA("TextButton") then
			ch:Destroy()
		end
	end

	tab.currentSub = nil

	for i, sub in ipairs(tab.subs) do
		local labelW = textWidth(sub.name, 12, "medium")
		sub.expandedW = COLLAPSED_W + labelW + 14

		local pill = I("Frame", {
			Parent = subBar,
			LayoutOrder = i,
			BackgroundColor3 = C("InputBg"),
			BackgroundTransparency = 0.45,
			Position = UDim2.fromOffset(8, (SUBBAR_H - PILL_H) / 2),
			Size = UDim2.fromOffset(COLLAPSED_W, PILL_H),
			ClipsDescendants = true,
			BorderSizePixel = 0,
			ZIndex = 31,
		})
		I("UICorner", { Parent = pill, CornerRadius = UDim.new(0, 8) })

		local iconHolder = I("Frame", {
			Parent = pill,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(COLLAPSED_W, PILL_H),
			ZIndex = 32,
		})
		if Icon[sub.icon] then
			Icon[sub.icon](iconHolder, COLLAPSED_W / 2, PILL_H / 2, 16, C("TextMuted")).ZIndex = 32
		end

		local label = txt(pill, COLLAPSED_W - 2, 0, labelW + 12, PILL_H, sub.name, 12, "Text", "medium")
		label.TextTransparency = 1
		label.ZIndex = 32

		sub.pill, sub.label, sub.iconHolder = pill, label, iconHolder

		local btn = I("TextButton", {
			Parent = pill,
			BackgroundTransparency = 1,
			Text = "",
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 33,
		})

		btn.MouseEnter:Connect(function()
			if tab.currentSub ~= sub then tween(pill, 0.14, { BackgroundTransparency = 0.15 }) end
		end)
		btn.MouseLeave:Connect(function()
			if tab.currentSub ~= sub then tween(pill, 0.18, { BackgroundTransparency = 0.45 }) end
		end)
		btn.MouseButton1Click:Connect(function()
			self:SelectSubTab(tab, sub)
		end)
	end

	if tab.subs[1] then self:SelectSubTab(tab, tab.subs[1]) end

	addRefresher(function()
		if currentTab == tab then
			self:_RefreshSubTabVisuals(tab)
		end
	end)
end

function UILibrary:SelectSubTab(tab, sub)
	if tab.currentSub == sub then return end
	local oldSub = tab.currentSub
	tab.currentSub = sub
	closePicker()
	closeAllDropdowns()

	if oldSub and oldSub.pill then
		tween(oldSub.pill, 0.18, { BackgroundTransparency = 0.45, BackgroundColor3 = C("InputBg") })
		tween(oldSub.label, 0.14, { TextTransparency = 1 })
		tweenIconColor(oldSub.iconHolder, C("TextMuted"), 0.2)
	end

	tweenIconColor(sub.iconHolder, C("Active"), 0.2)
	tween(sub.pill, 0.2, { BackgroundTransparency = 0, BackgroundColor3 = C("ActiveBg") })
	task.delay(0.06, function()
		if tab.currentSub == sub then tween(sub.label, 0.18, { TextTransparency = 0 }) end
	end)

	layoutSubBar(tab)
	sectionChip.Text = sub.name
	self:BuildPage(sub)
end

