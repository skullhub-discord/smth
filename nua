local function tryLoadChar(img)
	if not (charImage and charImage.Parent) then return false end
	charImage.Image = img
	local t0 = os.clock()
	while not charImage.IsLoaded and os.clock() - t0 < 2.0 do task.wait(0.05) end
	return charImage.IsLoaded
end

local function loadCharacterImage()
	task.spawn(function()
		task.wait(0.1)
		if not (charImage and charImage.Parent) then return end
		if charImage:GetAttribute("custom") then return end

		if DEFAULT_CHARACTER_ASSET and DEFAULT_CHARACTER_ASSET ~= "" then
			if tryLoadChar(DEFAULT_CHARACTER_ASSET) then return end
			local raw = tostring(DEFAULT_CHARACTER_ASSET):gsub("%D","")
			if raw ~= "" then
				tryLoadChar("rbxthumb://type=Asset&id=" .. raw .. "&w=512&h=512")
			end
		end
	end)
end

function UILibrary:RefreshVisibility()
	self:ApplySearch(searchBox and searchBox.Text or "")
end

function UILibrary:ApplySearch(query)
	if not contentL then return end
	local q = (query or ""):lower()
	for _, row in ipairs(contentL:GetChildren()) do
		if row:IsA("Frame") and row:GetAttribute("key") then
			local depHidden = row:GetAttribute("depHidden") == true
			if q == "" then
				row.Visible = not depHidden
			else
				row.Visible = (not depHidden) and row:GetAttribute("key"):find(q, 1, true) ~= nil
			end
		end
	end
end

local function newRow(sub, height)
	local row = I("Frame", {
		Parent = contentL,
		BackgroundColor3 = C("HoverBg"),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(COL_W_L, height),
		LayoutOrder = #sub.rows + 1,
		ZIndex = 22,
		BorderSizePixel = 0,
	})
	I("UICorner", { Parent = row, CornerRadius = UDim.new(0, 7) })
	row:SetAttribute("w", COL_W_L)
	sub.rows[#sub.rows + 1] = row
	return row
end

function UILibrary:BuildPage(sub)
	clearRefreshers()

	for _, ch in ipairs(contentL:GetChildren()) do
		if ch:IsA("Frame") then ch:Destroy() end
	end
	sub.rows = {}

	if sub.build then
		local ok, err = pcall(sub.build, sub)
		if not ok then warn("[UILibrary] Build error '" .. tostring(sub.name) .. "': " .. tostring(err)) end
	end

	self:ApplySearch(searchBox.Text)
end

function UILibrary:AddToggle(sub, cfg)
	cfg = cfg or {}
	local row = newRow(sub, 24)
	local W = row:GetAttribute("w")

	local label = txt(row, 10, 0, W - 96, 24, cfg.Name or "toggle", 12, C("TextDim"))
	label.ZIndex = 23

	local obj = { Name = cfg.Name, value = cfg.Default == true, ColorValue = nil, Row = row }
	local swatch, swGlow

	if cfg.Color then
		obj.ColorValue = typeof(cfg.Color) == "Color3" and cfg.Color or Color3.fromRGB(255, 255, 255)

		swGlow = I("Frame", {
			Parent = row,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(W - 64, 12),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = obj.ColorValue,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 23,
		})
		I("UICorner", { Parent = swGlow, CornerRadius = UDim.new(1, 0) })

		swatch = I("TextButton", {
			Parent = row,
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(W - 64, 12),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = obj.ColorValue,
			BorderSizePixel = 0,
			ZIndex = 24,
		})
		I("UICorner", { Parent = swatch, CornerRadius = UDim.new(1, 0) })
		strokeOn(swatch, "Border", 1, 0.55).ZIndex = 25

		local function setSwatchColor(c)
			swatch.BackgroundColor3 = c
			swGlow.BackgroundColor3 = c
		end

		swatch.MouseEnter:Connect(function()
			tween(swGlow, 0.14, { BackgroundTransparency = 0.90 })
			tween(swatch, 0.12, { Size = UDim2.fromOffset(16, 16) })
		end)
		swatch.MouseLeave:Connect(function()
			if pickerState.open and pickerState.frame then
				tween(swGlow, 0.14, { BackgroundTransparency = 0.92 })
			else
				tween(swGlow, 0.14, { BackgroundTransparency = 1 })
			end
			tween(swatch, 0.14, { Size = UDim2.fromOffset(14, 14) })
		end)

		swatch.MouseButton1Click:Connect(function()
			tween(swGlow, 0.14, { BackgroundTransparency = 0.92 })
			openPicker(swatch, obj.ColorValue, function(c)
				obj.ColorValue = c
				setSwatchColor(c)
				if cfg.OnColor then task.spawn(cfg.OnColor, c) end
			end)
		end)
	end

	local track = rectTL(row, W - 42, 4, 31, 16, C("TrackOff"), 8, 0)
	track.ZIndex = 23
	track.ClipsDescendants = false

	local switchGlow = I("Frame", {
		Parent = row,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(W - 26.5, 12),
		Size = UDim2.fromOffset(44, 28),
		BackgroundColor3 = C("Active"),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 22,
	})
	I("UICorner", { Parent = switchGlow, CornerRadius = UDim.new(1, 0) })

	local knob = circFrame(track, 8, 8, 12, C("KnobOff"), 0, 24)

	local function render(on)
		if on then
			tween(knob, 0.16, { Position = UDim2.fromOffset(23, 8), BackgroundColor3 = C("Active") }, Enum.EasingStyle.Quart)
			tween(track, 0.16, { BackgroundColor3 = C("ActiveBg") }, Enum.EasingStyle.Quart)
			tween(label, 0.16, { TextColor3 = C("Text") }, Enum.EasingStyle.Quart)
			tween(switchGlow, 0.18, { BackgroundTransparency = 0.92 })
		else
			tween(knob, 0.16, { Position = UDim2.fromOffset(8, 8), BackgroundColor3 = C("KnobOff") }, Enum.EasingStyle.Quart)
			tween(track, 0.16, { BackgroundColor3 = C("TrackOff") }, Enum.EasingStyle.Quart)
			tween(label, 0.16, { TextColor3 = C("TextDim") }, Enum.EasingStyle.Quart)
			tween(switchGlow, 0.18, { BackgroundTransparency = 1 })
		end
	end

	local function set(on, silent)
		obj.value = on and true or false
		render(obj.value)
		if cfg.Name then UILibrary.Flags[cfg.Name] = obj.value end
		if not silent and cfg.Callback then task.spawn(cfg.Callback, obj.value) end
	end
	obj.Set = set

	local btn = I("TextButton", {
		Parent = row,
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 23,
	})
	btn.MouseEnter:Connect(function()
		tween(row, 0.12, { BackgroundTransparency = 0.55 })
	end)
	btn.MouseLeave:Connect(function()
		tween(row, 0.16, { BackgroundTransparency = 1 })
	end)
	btn.MouseButton1Click:Connect(function()
		set(not obj.value)
	end)

	row:SetAttribute("key", (cfg.Name or "toggle"):lower())
	set(obj.value, true)

	addRefresher(function()
		render(obj.value)
	end)

	return obj
end

