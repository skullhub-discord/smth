function UILibrary:AddKeybind(sub, cfg)
	cfg = cfg or {}
	local row = newRow(sub, 24)
	local W = row:GetAttribute("w")

	local label = txt(row, 10, 0, W - 130, 24, cfg.Name or "keybind", 12, "TextDim")
	label.ZIndex = 23

	local modes = cfg.Modes or { "Toggle", "Hold", "Always" }
	local obj = { Name = cfg.Name, value = nil, mode = cfg.Mode or modes[1], Row = row, binding = false }

	local modeBtn = I("TextButton", {
		Parent = row,
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(W - 62, 12),
		Size = UDim2.fromOffset(48, 18),
		BackgroundColor3 = C("InputBg"),
		BorderSizePixel = 0,
		ZIndex = 23,
	})
	I("UICorner", { Parent = modeBtn, CornerRadius = UDim.new(0, 5) })
	strokeOn(modeBtn, "Border", 1, 0.7).ZIndex = 24
	bindTheme(modeBtn, "BackgroundColor3", "InputBg")
	local modeL = txt(modeBtn, 0, 0, 48, 18, "", 10, "TextMuted", "medium", Enum.TextXAlignment.Center)
	modeL.ZIndex = 25

	local keyBtn = I("TextButton", {
		Parent = row,
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(W - 10, 12),
		Size = UDim2.fromOffset(48, 18),
		BackgroundColor3 = C("InputBg"),
		BorderSizePixel = 0,
		ZIndex = 23,
	})
	I("UICorner", { Parent = keyBtn, CornerRadius = UDim.new(0, 5) })
	strokeOn(keyBtn, "Border", 1, 0.7).ZIndex = 24
	bindTheme(keyBtn, "BackgroundColor3", "InputBg")
	local keyL = txt(keyBtn, 0, 0, 48, 18, "", 10, "Text", "medium", Enum.TextXAlignment.Center)
	keyL.ZIndex = 25

	local function fire()
		if cfg.Callback then task.spawn(cfg.Callback, obj.value, obj.mode) end
	end
	local function render()
		keyL.Text = obj.binding and "..." or keyDisplayName(obj.value)
		modeL.Text = tostring(obj.mode)
	end
	function obj.Set(v, silent)
		if typeof(v) == "string" then
			if v == "None" or v == "none" or v == "" then v = nil
			else
				local ok, e = pcall(function() return Enum.KeyCode[v] end)
				if ok and e then v = e else
					local ok2, e2 = pcall(function() return Enum.UserInputType[v] end)
					v = (ok2 and e2) or nil
				end
			end
		end
		obj.value = v
		render()
		if not silent then fire() end
	end
	function obj.SetMode(m, silent)
		obj.mode = m
		render()
		if not silent then fire() end
	end

	modeBtn.MouseButton1Click:Connect(function()
		local idx = table.find(modes, obj.mode) or 0
		obj.SetMode(modes[(idx % #modes) + 1])
	end)

	keyBtn.MouseButton1Click:Connect(function()
		if obj.binding then return end
		obj.binding = true
		render()
		local conn
		conn = UserInputService.InputBegan:Connect(function(inp)
			local v
			if inp.UserInputType == Enum.UserInputType.Keyboard then
				v = inp.KeyCode
			elseif inp.UserInputType == Enum.UserInputType.MouseButton2 or inp.UserInputType == Enum.UserInputType.MouseButton3 then
				v = inp.UserInputType
			elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
				return
			else
				return
			end
			conn:Disconnect()
			obj.binding = false
			if v == Enum.KeyCode.Escape or v == Enum.KeyCode.Backspace then
				obj.Set(nil)
			else
				obj.Set(v)
			end
		end)
		task.delay(5, function()
			if obj.binding then
				obj.binding = false
				render()
				if conn then conn:Disconnect() end
			end
		end)
	end)

	obj.Set(cfg.Default, true)
	row:SetAttribute("key", (cfg.Name or "keybind"):lower())
	addRefresher(render)
	return obj
end

