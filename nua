local function addRefresher(fn)
	themeRefreshers[#themeRefreshers+1] = fn
end

local function clearRefreshers()
	table.clear(themeRefreshers)
end

local function bindTheme(obj, prop, key)
	themeBinds[#themeBinds+1] = { Obj = obj, Prop = prop, Key = key }
end

function UILibrary:ApplyTheme()
	for i = #themeBinds, 1, -1 do
		local b = themeBinds[i]
		local obj = b.Obj
		if not obj or not obj.Parent then
			table.remove(themeBinds, i)
		else
			local ok = pcall(function()
				obj[b.Prop] = C(b.Key)
			end)
			if not ok then
				table.remove(themeBinds, i)
			end
		end
	end

	for _, fn in ipairs(themeRefreshers) do
		pcall(fn)
	end

	if currentTab then
		self:_RefreshTabVisuals()
		self:_RefreshSubTabVisuals(currentTab)
	end
end

function UILibrary:SetThemeColor(key, color)
	if typeof(color) ~= "Color3" then return end
	if UILibrary.Theme[key] == nil then return end
	UILibrary.Theme[key] = color
	self:ApplyTheme()
end

function UILibrary:ResetTheme()
	for k, v in pairs(DefaultTheme) do
		UILibrary.Theme[k] = v
	end
	self:ApplyTheme()
end

local function I(class, props)
	local obj = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function tween(obj, time, props, style, dir)
	TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	):Play()
end

local function strokeOn(obj, colorOrKey, thickness, transparency)
	local col = colorOrKey
	if typeof(colorOrKey) == "string" then col = C(colorOrKey) end
	local st = I("UIStroke", {
		Parent = obj,
		Color = col,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
	if typeof(colorOrKey) == "string" then
		bindTheme(st, "Color", colorOrKey)
	end
	return st
end

local function rectTL(parent, x, y, w, h, colorOrKey, radius, transparency)
	local col = colorOrKey
	if typeof(colorOrKey) == "string" then col = C(colorOrKey) end
	local f = I("Frame", {
		Parent = parent,
		BackgroundColor3 = col,
		BackgroundTransparency = transparency or 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BorderSizePixel = 0,
	})
	if radius then I("UICorner", { Parent = f, CornerRadius = UDim.new(0, radius) }) end
	if typeof(colorOrKey) == "string" then
		bindTheme(f, "BackgroundColor3", colorOrKey)
	end
	return f
end

local function circFrame(parent, cx, cy, d, colorOrKey, transparency, z)
	local col = colorOrKey
	if typeof(colorOrKey) == "string" then col = C(colorOrKey) end
	local f = I("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, cy),
		Size = UDim2.fromOffset(d, d),
		BackgroundColor3 = col,
		BackgroundTransparency = transparency or 0,
		BorderSizePixel = 0,
		ZIndex = z,
	})
	I("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
	if typeof(colorOrKey) == "string" then
		bindTheme(f, "BackgroundColor3", colorOrKey)
	end
	return f
end

local function applyFont(obj, weight)
	local list
	if weight == "bold" then
		list = { Enum.Font.GothamBold, Enum.Font.GothamBlack, Enum.Font.SourceSansBold }
	elseif weight == "medium" then
		list = { Enum.Font.GothamMedium, Enum.Font.GothamSemibold, Enum.Font.Gotham, Enum.Font.SourceSans }
	else
		list = { Enum.Font.Gotham, Enum.Font.SourceSans, Enum.Font.Arial }
	end
	for _, f in ipairs(list) do
		local ok = pcall(function() obj.Font = f end)
		if ok then break end
	end
end

local function txt(parent, x, y, w, h, text, size, colorOrKey, weight, align)
	local col = colorOrKey
	if typeof(colorOrKey) == "string" then col = C(colorOrKey) end
	local l = I("TextLabel", {
		Parent = parent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Text = text,
		TextSize = size,
		TextColor3 = col,
		TextXAlignment = align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
	applyFont(l, weight)
	if typeof(colorOrKey) == "string" then
		bindTheme(l, "TextColor3", colorOrKey)
	end
	return l
end

local function textWidth(text, size, weight)
	local ok, r = pcall(function()
		return TextService:GetTextSize(
			text,
			size,
			weight == "medium" and Enum.Font.GothamMedium or Enum.Font.Gotham,
			Vector2.new(1000, 20)
		)
	end)
	if ok then return r.X end
	return #text * size * 0.55
end

local function tweenIconColor(holder, color, duration)
	for _, d in ipairs(holder:GetDescendants()) do
		if d:IsA("Frame") then
			tween(d, duration, { BackgroundColor3 = color })
		elseif d:IsA("UIStroke") then
			tween(d, duration, { Color = color })
		elseif d:IsA("TextLabel") then
			tween(d, duration, { TextColor3 = color })
		elseif d:IsA("ImageLabel") then
			tween(d, duration, { ImageColor3 = color })
		end
	end
end

local function hexOf(c)
	return string.format("#%02x%02x%02x",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end

