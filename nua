function UILibrary:Build(opts)
	opts = opts or {}
	if not playerGui then
		player = Players.LocalPlayer
		if player then playerGui = player:WaitForChild("PlayerGui") end
	end
	assert(playerGui, "UILibrary must run on client (PlayerGui not found).")

	local old = playerGui:FindFirstChild("GameUI_Real")
	if old then old:Destroy() end

	self:Destroy()

	screenGui = I("ScreenGui", {
		Name = "GameUI_Real",
		Parent = playerGui,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 100,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	-- Changed to CanvasGroup so we can fade everything smoothly
	Stage = I("CanvasGroup", {
		Name = "Stage",
		Parent = screenGui,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(CANVAS_W, CANVAS_H),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
	})

	buildMainPanel()
	buildSidebar()
	fitSidebar()
	buildSubBar()
	buildTargetHUD()
	buildFooter()
	loadCharacterImage()
	UILibrary:BuildFOVCircle()

	setupDragging()

	-- =====================================================================
	-- DYNAMIC SCALING AND BOTTOM-RIGHT TOGGLE BUTTON
	-- =====================================================================
	do
		local scale = opts.Scale or 1
		local isMobileDevice = opts.IsMobile or false

		-- Handle scaling for Tablet and Phone
		if scale ~= 1 or isMobileDevice then
			local oldScale = Stage:FindFirstChild("AX_UIScale")
			if oldScale then oldScale:Destroy() end
			local sc = Instance.new("UIScale")
			sc.Name = "AX_UIScale"
			sc.Scale = scale
			sc.Parent = Stage
		end
	end

	-- Bottom Right Fade Toggle Button (Sleek Custom Design)
	local toggleBtn = I("TextButton", {
		Parent = screenGui,
		Name = "ToggleUIButton",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.fromOffset(120, 34), -- Wider rectangle shape
		BackgroundColor3 = C("SubBarBg"),
		BorderSizePixel = 0,
		Text = "",
		ZIndex = 1000,
		AutoButtonColor = false
	})
	I("UICorner", { Parent = toggleBtn, CornerRadius = UDim.new(1, 0) }) -- Pill shape (fully rounded edges)
	local btnStroke = strokeOn(toggleBtn, "Border", 1, 0.4)
	btnStroke.ZIndex = 1001

	-- Hamburger Menu Icon
	local btnIcon = Icon.hamburger(toggleBtn, 20, 17, 14, C("TextDim"))
	btnIcon.ZIndex = 1002

	-- Text Label
	local btnText = txt(toggleBtn, 36, 0, 74, 34, "Toggle UI", 12, "TextDim", "medium")
	btnText.ZIndex = 1002

	toggleBtn.MouseEnter:Connect(function()
		tween(toggleBtn, 0.15, {BackgroundColor3 = C("HoverBg")})
		tween(btnIcon, 0.15, {ImageColor3 = C("Active")})
		tween(btnText, 0.15, {TextColor3 = C("Active")})
	end)
	toggleBtn.MouseLeave:Connect(function()
		tween(toggleBtn, 0.15, {BackgroundColor3 = C("SubBarBg")})
		tween(btnIcon, 0.15, {ImageColor3 = C("TextDim")})
		tween(btnText, 0.15, {TextColor3 = C("TextDim")})
	end)
	toggleBtn.MouseButton1Click:Connect(function() UILibrary:ToggleUI() end)

	if autoConn then pcall(function() autoConn:Disconnect() end) end
	autoConn = RunService.RenderStepped:Connect(autoTargetTick)

	if UILibrary._toggleConn then pcall(function() UILibrary._toggleConn:Disconnect() end) end
	UILibrary._toggleConn = UserInputService.InputBegan:Connect(function(inp, gpe)
		if gpe then return end
		if inp.KeyCode == toggleKey then
			UILibrary:ToggleUI()
		end
	end)

	if opts.EnableSettings ~= false then
		self:_BuildSettingsTab()
	end

	self.Refs = {
		ScreenGui = screenGui,
		Stage = Stage,
		Sidebar = sidebar,
		MainPanel = mainPanel,
		CharacterImage = charImage,
		SubTabsBar = subBar,
		TargetHUD = hudRefs.outer,
		SearchBox = searchBox,
		ContentL = contentL,
		Footer = footerRefs.footer,
	}

	self:ApplyTheme()

	return self.Refs
end

return UILibrary
