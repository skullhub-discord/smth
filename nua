function UILibrary:AddDropdown(sub, cfg)
	cfg = cfg or {}
	local row = newRow(sub, 43)
	local W = row:GetAttribute("w")
	local bw = W - 20

	txt(row, 10, 0, bw, 14, cfg.Name or "dropdown", 10, "TextMuted").ZIndex = 23

	local box = I("TextButton", {
		Parent = row,
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(10, 16),
		Size = UDim2.fromOffset(bw, 27),
		BackgroundColor3 = C("InputBg"),
		BorderSizePixel = 0,
		ZIndex = 23,
	})
	I("UICorner", { Parent = box, CornerRadius = UDim.new(0, 6) })
	strokeOn(box, "Border", 1, 0.7).ZIndex = 24
	bindTheme(box, "BackgroundColor3", "InputBg")

	local value = txt(box, 10, 0, bw - 40, 27, "", 12, "Text")
	value.ZIndex = 25

	local chev = chevronVector(box, bw - 16, 14, 12, C("TextDim"))
	chev.ZIndex = 25

	local multi = cfg.Multi == true
	local obj = { Name = cfg.Name, options = cfg.Options or cfg.Values or {}, value = nil, open = false, Row = row, Multi = multi }
	local list
	local function isSelected(opt)
		if not multi then return obj.value == opt end
		if type(obj.value) ~= "table" then return false end
		return table.find(obj.value, opt) ~= nil
	end
	local function renderValueText()
		if multi then
			local parts = {}
			if type(obj.value) == "table" then
				for _, o in ipairs(obj.value) do parts[#parts + 1] = tostring(o) end
			end
			value.Text = (#parts > 0) and table.concat(parts, ", ") or "none"
		else
			value.Text = tostring(obj.value)
		end
	end

	local function close()
		obj.open = false
		tween(chev, 0.16, { Rotation = 0 })
		if list then
			local l = list
			list = nil
			tween(l, 0.14, { Size = UDim2.fromOffset(bw, 0) })
			task.delay(0.16, function() if l then l:Destroy() end end)
		end
	end

	local function select(opt, silent)
		if multi then
			if type(opt) == "table" then
				local arr = {}
				for k, v in pairs(opt) do
					if type(k) == "number" then arr[#arr + 1] = v
					elseif v == true then arr[#arr + 1] = k end
				end
				obj.value = arr
			elseif opt ~= nil then
				obj.value = type(obj.value) == "table" and obj.value or {}
				local idx = table.find(obj.value, opt)
				if idx then table.remove(obj.value, idx) else obj.value[#obj.value + 1] = opt end
			else
				obj.value = {}
			end
		else
			obj.value = opt
		end
		renderValueText()
		if cfg.Name then UILibrary.Flags[cfg.Name] = obj.value end
		if not silent and cfg.Callback then
			if multi then
				local copy = table.clone(obj.value)
				task.spawn(cfg.Callback, copy)
			else
				task.spawn(cfg.Callback, opt)
			end
		end
	end
	obj.Select = select
	obj.Set = select

	local function open()
		closeAllDropdowns()
		obj.open = true
		tween(chev, 0.16, { Rotation = 180 })

		local h = #obj.options * 26 + 10
		local stageP = Stage.AbsolutePosition
		local lx = row.AbsolutePosition.X - stageP.X + 10
		local ly = row.AbsolutePosition.Y - stageP.Y + 45
		if ly + h > CANVAS_H - 6 then ly = row.AbsolutePosition.Y - stageP.Y - h - 4 end

		list = I("Frame", {
			Name = "DropdownList",
			Parent = Stage,
			BackgroundColor3 = C("SubBarBg"),
			Position = UDim2.fromOffset(lx, ly),
			Size = UDim2.fromOffset(bw, 0),
			ClipsDescendants = true,
			BorderSizePixel = 0,
			ZIndex = 150,
		})
		I("UICorner", { Parent = list, CornerRadius = UDim.new(0, 10) })
		strokeOn(list, "Border", 1, 0.55).ZIndex = 151
		bindTheme(list, "BackgroundColor3", "SubBarBg")

		I("UIListLayout", { Parent = list, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
		I("UIPadding", { Parent = list, PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5) })

		for i, opt in ipairs(obj.options) do
			local ob = I("TextButton", {
				Parent = list,
				LayoutOrder = i,
				Text = tostring(opt),
				BackgroundColor3 = C("HoverBg"),
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 24),
				TextColor3 = isSelected(opt) and C("Text") or C("TextDim"),
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				BorderSizePixel = 0,
				ZIndex = 151,
			})
