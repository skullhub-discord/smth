local function connectDrag(handle, getGroup)
	handle.Active = true
	local dragging = false
	local dragStart
	local startPositions = {}
	local lastTween = {}

	local function begin(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		closePicker()
		closeAllDropdowns()

		dragging = true
		dragStart = input.Position
		table.clear(startPositions)

		for _, obj in ipairs(getGroup()) do
			if obj and obj.Parent then
				startPositions[obj] = obj.Position
			end
		end
	end

	local function update(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart
		for obj, pos in pairs(startPositions) do
			if obj and obj.Parent then
				local targetPos = UDim2.fromOffset(
					pos.X.Offset + delta.X,
					pos.Y.Offset + delta.Y
				)
				if lastTween[obj] then
					pcall(function() lastTween[obj]:Cancel() end)
				end
				local tw = TweenService:Create(obj, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = targetPos })
				lastTween[obj] = tw
				tw:Play()
			end
		end
	end

	local function ended(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = false
		for obj, _ in pairs(startPositions) do
			if obj and obj.Parent and lastTween[obj] then
				pcall(function() lastTween[obj]:Cancel() end)
			end
		end
	end

	dragConns[#dragConns+1] = handle.InputBegan:Connect(begin)
	dragConns[#dragConns+1] = UserInputService.InputChanged:Connect(update)
	dragConns[#dragConns+1] = UserInputService.InputEnded:Connect(ended)
end

local function setupDragging()
	local function mainGroup()
		local g = { mainPanel, sidebar, subBar }
		return g
	end

	connectDrag(mainPanel, mainGroup)
	connectDrag(sidebar, mainGroup)
	connectDrag(subBar, mainGroup)

	if footerRefs and footerRefs.footer then
		local function footerGroup()
			return { footerRefs.footer }
		end
		connectDrag(footerRefs.footer, footerGroup)
	end

	addRefresher(function()
		fitSidebar()
		layoutSubBar(currentTab or { subs = {}, currentSub = nil })
	end)
end

