function UILibrary:AddSlider(sub, cfg)
	cfg = cfg or {}
	local min, max = cfg.Min or 0, cfg.Max or 100
	local row = newRow(sub, 37)
	local W = row:GetAttribute("w")
	local tw = W - 20

	txt(row, 10, 0, 170, 15, cfg.Name or "slider", 12, "TextDim").ZIndex = 23
	local valueL = txt(row, 10, 0, tw, 15, "", 12, "Text", "medium", Enum.TextXAlignment.Right)
	valueL.ZIndex = 23

	local track = I("TextButton", {
		Parent = row,
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(10, 22),
		Size = UDim2.fromOffset(tw, 4),
		BackgroundColor3 = C("TrackOff"),
		BorderSizePixel = 0,
		ZIndex = 23,
	})
	I("UICorner", { Parent = track, CornerRadius = UDim.new(0, 2) })

	local fill = rectTL(track, 0, 0, 100, 4, C("Active"), 2, 0); fill.ZIndex = 24
	local knobS = circFrame(track, 6, 2, 11, C("Active"), 0, 25)

	local obj = { Name = cfg.Name, value = cfg.Default or min, Row = row }
	local step = tonumber(cfg.Step)
	local decimals = cfg.Decimals
	if not decimals and step and step > 0 and step < 1 then
		local s = tostring(step)
		local dot = s:find("%.")
		decimals = dot and (#s - dot) or 2
		if s:find("e%-") then decimals = 6 end
	end
	local function set(v, silent)
		v = math.clamp(v, min, max)
		if step and step > 0 then
			v = min + math.floor((v - min) / step + 0.5) * step
			v = math.clamp(v, min, max)
		end
		if decimals then
			local m = 10 ^ decimals
			v = math.floor(v * m + 0.5) / m
		elseif not step then
			v = math.floor(v + 0.5)
		end
		obj.value = v

		local fw = math.max(5, tw * (v - min) / (max - min))
		tween(fill, 0.10, { Size = UDim2.fromOffset(fw, 4) })
		tween(knobS, 0.10, { Position = UDim2.fromOffset(fw, 2) })
		valueL.Text = tostring(v) .. (cfg.Suffix or "")

		if cfg.Name then UILibrary.Flags[cfg.Name] = v end
		if not silent and cfg.Callback then task.spawn(cfg.Callback, v) end
	end
	obj.Set = set

	local sliding = false
	track.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then sliding = true end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then sliding = false end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			local t = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			set(min + (max - min) * t)
		end
	end)

	set(obj.value, true)
	row:SetAttribute("key", (cfg.Name or "slider"):lower())

	addRefresher(function()
		track.BackgroundColor3 = C("TrackOff")
		fill.BackgroundColor3 = C("Active")
		knobS.BackgroundColor3 = C("Active")
		valueL.TextColor3 = C("Text")
	end)

	return obj
end

