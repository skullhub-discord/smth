local function chevronVector(parent, cx, cy, size, color)
	local holder = I("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(cx, cy),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	local w, h = size * 0.52, math.max(2, size * 0.14)
	local function bar(px, py, rw, rh, rot)
		local f = I("Frame", {
			Parent = holder,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(px, py),
			Size = UDim2.fromOffset(rw, rh),
			Rotation = rot,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		})
		I("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
	end
	bar(size * 0.5 - size * 0.13, size * 0.46, w, h, 45)
	bar(size * 0.5 + size * 0.13, size * 0.46, w, h, -45)
	return holder
end

